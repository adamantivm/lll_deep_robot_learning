diff --git a/latest_deps_sweep.py b/latest_deps_sweep.py
new file mode 100644
--- /dev/null
+++ b/latest_deps_sweep.py
@@ -0,0 +1,20 @@
+"""[latest-deps change] Small seed sweep to compare pinned vs team env. No video (rendering off).
+
+Usage: python latest_deps_sweep.py <label> <mode> <seed0> <n>   -> appends JSON lines to rollouts/sweep_<label>.jsonl
+"""
+import json, sys
+from pathlib import Path
+import mujoco
+import rollout
+
+label, mode, seed0, n = sys.argv[1], sys.argv[2], int(sys.argv[3]), int(sys.argv[4])
+revision = json.loads(Path(rollout.__file__).with_name("manifest.json").read_text()).get("model_revision")
+out = Path(rollout.__file__).with_name("rollouts") / f"sweep_{label}.jsonl"
+for seed in range(seed0, seed0 + n):
+    _, m = rollout.run(seed, mode, output="", revision=revision)
+    row = {k: m[k] for k in ("controller", "seed", "success", "control_steps", "object_xyz", "lift_m",
+                             "max_spare_displacement_m", "wall_seconds")}
+    row.update(label=label, mujoco=mujoco.__version__)
+    print(json.dumps(row), flush=True)
+    with out.open("a") as f:
+        f.write(json.dumps(row) + "\n")
