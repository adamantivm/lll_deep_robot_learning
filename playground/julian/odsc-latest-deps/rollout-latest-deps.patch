+def _compat_checkpoint_dir(path, tmp):
+    """[latest-deps change] Return a checkpoint dir loadable by the installed LeRobot.
+
+    The checkpoint was saved by a LeRobot dev build (7521ab48) whose ACTConfig and
+    RelativeActionsProcessorStep had relative-action / pose-mode fields that LeRobot 0.7
+    removed. Those fields are inert here (use_relative_actions=False, steps disabled), so
+    we write cleaned JSON copies to `tmp` and symlink the unchanged .safetensors. Only the
+    known relative-action keys below are ever dropped, and only while inactive; any other
+    unknown key raises. Returns `path` unchanged when nothing needs dropping (e.g. on the
+    pinned env).
+    """
+    import dataclasses, os
+    from lerobot.policies.act.configuration_act import ACTConfig
+    from lerobot.processor.pipeline import ProcessorStepRegistry
+
+    droppable_config = {"use_relative_actions", "relative_exclude_joints", "relative_action_mode",
+                        "relative_pose_position_names", "relative_pose_rotation_names",
+                        "relative_pose_rotation_format", "relative_reference_key", "action_feature_names"}
+    droppable_steps = {"relative_actions_processor": {"mode", "position_names", "rotation_names",
+                                                      "rotation_format", "reference_key"}}
+    src = Path(path)
+    fixed, dropped = {}, {}
+    # 1) policy config.json: keys unknown to ACTConfig
+    cfg = json.loads((src / "config.json").read_text())
+    known = {f.name for f in dataclasses.fields(ACTConfig)} | {"type"}
+    unknown = sorted(set(cfg) - known)
+    if unknown:
+        if set(unknown) - droppable_config:
+            raise ValueError(f"Unknown config keys this compat shim doesn't handle: "
+                             f"{sorted(set(unknown) - droppable_config)}")
+        if cfg.get("use_relative_actions"):
+            raise ValueError(f"Cannot drop active relative-action fields: {unknown}")
+        fixed["config.json"] = {k: v for k, v in cfg.items() if k not in unknown}
+        dropped["config.json"] = unknown
+    # 2) processor pipelines: step-config keys unknown to the registered step class
+    for name in ("policy_preprocessor.json", "policy_postprocessor.json"):
+        pipe = json.loads((src / name).read_text())
+        changed = False
+        for step in pipe["steps"]:
+            step_cls = ProcessorStepRegistry.get(step["registry_name"])
+            if not dataclasses.is_dataclass(step_cls):
+                continue
+            fields = {f.name for f in dataclasses.fields(step_cls)}
+            extra = sorted(set(step.get("config", {})) - fields)
+            if extra:
+                unhandled = sorted(set(extra) - droppable_steps.get(step["registry_name"], set()))
+                if unhandled:
+                    raise ValueError(f"Unknown keys {unhandled} in step {step['registry_name']} "
+                                     f"that this compat shim doesn't handle")
+                if step["config"].get("enabled", True):
+                    raise ValueError(f"Cannot drop fields {extra} of active step {step['registry_name']}")
+                step["config"] = {k: v for k, v in step["config"].items() if k not in extra}
+                dropped[f"{name}:{step['registry_name']}"] = extra
+                changed = True
+        if changed:
+            fixed[name] = pipe
+    if not fixed:
+        return path
+    print(f"[compat] dropping inert keys unknown to this LeRobot: {dropped}")
+    for item in src.iterdir():
+        target = Path(tmp) / item.name
+        if item.name in fixed:
+            target.write_text(json.dumps(fixed[item.name], indent=2))
+        else:
+            os.symlink(item.resolve(), target)
+    return tmp
+
